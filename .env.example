# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/localhub-tokyo
# Alternatively use MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/localhub-tokyo?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRE=30d

# Client Configuration
CLIENT_URL=http://localhost:5173
